{
  "name": "@devhotel/core",
  "version": "0.5.4",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --maxWorkers=1 --testTimeout=20000",
    "probe:managed-runtime": "vitest run scripts/probe-managed-runtime.test.ts --maxWorkers=1 --reporter=verbose --testTimeout=180000",
    "pin:android-sdk": "vitest run scripts/pin-android-sdk.test.ts --maxWorkers=1 --reporter=verbose --testTimeout=2700000",
    "report:host-footprint": "vitest run scripts/host-footprint-report.test.ts --maxWorkers=1 --reporter=verbose --testTimeout=120000",
    "report:volume-gc": "vitest run scripts/volume-gc-report.test.ts --maxWorkers=1 --reporter=verbose --testTimeout=180000"
  },
  "dependencies": {
    "@devhotel/shared": "workspace:*",
    "js-yaml": "^4.1.0",
    "nanoid": "^5.0.9",
    "node-forge": "^1.3.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.0",
    "@types/node-forge": "^1.3.11",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0"
  }
}
