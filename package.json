{
  "name": "devhotel",
  "private": true,
  "version": "0.2.2",
  "type": "module",
  "description": "Every project gets its own room — a browser for isolated local development servers.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "pnpm --filter @devhotel/desktop dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --if-present test",
    "lint": "eslint .",
    "build:installer": "pnpm --filter devhotel-mcp build && pnpm --filter @devhotel/desktop build:installer"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "eslint": "^9.20.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.24.0"
  }
}
